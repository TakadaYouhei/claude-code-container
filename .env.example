# claude-code-container 環境変数サンプル
# 使い方: cp .env.example .env してから値を編集する（docs/manual.md 3.2章）

# 必須: 初回起動時に自動 clone する対象リポジトリの URL
# GitHub PAT 付き HTTPS URL や SSH 鍵経由の URL を指定する
GIT_REPO_URL=

# 任意（既定 main）: セッション用ブランチの作成元となるベースブランチ
GIT_BASE_BRANCH=main

# 任意（既定は自動検出）: 使用するコンテナエンジン（docker または podman）
# 未指定の場合、docker コマンドがあれば docker、無く podman のみがあれば podman を自動選択する
CONTAINER_ENGINE=

# 任意: API キー認証を使う場合に設定する（未設定時は OAuth ログイン: claude login を想定）
ANTHROPIC_API_KEY=

# 任意（既定 true）: 自動承認モード（--dangerously-skip-permissions 相当）の有効/無効
CLAUDE_AUTO_APPROVE=true

# 任意（既定 latest）: インストールする Claude Code CLI のバージョン
CLAUDE_CODE_VERSION=latest

# 任意（既定 1000）: コンテナ内非rootユーザーの UID/GID（ホストとのファイル所有者整合用）
CONTAINER_UID=1000
CONTAINER_GID=1000
